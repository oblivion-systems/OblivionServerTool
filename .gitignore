# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/

# ── PyInstaller build artefacts ───────────────────────────────────────────────
dist/
build/
*.spec

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── User config (may contain passwords / personal paths) ─────────────────────
oblivion_config.json
# v0.10.2 match history + v0.10.0 plugin manifest — local state, not source
oblivion_matches.json
oblivion_plugins.json
# v0.16.1 / v0.16.3 — persisted teams + templates (runtime state)
oblivion_teams.json
oblivion_templates.json
# v0.11.3 — persisted veto session (runtime state, survives Ctrl+Q)
oblivion_veto_active.json
# v0.16.0 auto-snapshots of oblivion_config.json — dev-mode writes them to project root
backups/
# v0.15.1 registry catalog cache (24h TTL, fetched at runtime)
registry_cache.json
# v0.16.5 WebView2 bootstrapper — downloaded artefact, not source.
# tools/fetch_webview2.ps1 re-downloads on demand before each installer build.
MicrosoftEdgeWebview2Setup.exe
# Raw screenshot intake + intermediate redaction work-folder.
# Public-facing prepared shots live in docs/screenshots/ instead.
screenshots/
# v0.11.0 — operator may stash a Discord bot token / webhook URL locally
# before pasting into the SPA.  Keep secrets out of git regardless of name.
bot_token.txt
*_token.txt
*_secret.txt
.env

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.user
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
build_log.txt
build_log.prev.txt
build_log_*.txt

# ── Downloaded third-party installers (Process Lasso etc.) ───────────────────
downloads/

# ── Claude Code session data ──────────────────────────────────────────────────
.claude/

# ── Nested clone (not a submodule) ────────────────────────────────────────────
OblivionServerTool/

# Plugin release ZIPs downloaded by the install helper
.plugin-downloads/

# .NET build artifacts for bundled plugin source (keep the .cs/.csproj, not bin/obj)
_plugins_src/**/bin/
_plugins_src/**/obj/
